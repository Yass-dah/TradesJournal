<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.DatePicker?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Pane?>
<VBox layoutX="14.0" layoutY="170.0" spacing="6.0"
      AnchorPane.leftAnchor="14.0"
      AnchorPane.rightAnchor="14.0"
      style="-fx-background-color: #252526; -fx-border-color: #3d3d3d; -fx-border-radius: 4; -fx-background-radius: 4;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fx.tradesjournal.controllers.DateFilterController">
    <padding>
        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
    </padding>
    <Label text="From:" textFill="#a0a0a0"/>
    <DatePicker fx:id="fromDate" promptText="No date selected"
                onAction="#handleDateFilterChange" prefHeight="30.0" prefWidth="240.0"
                style="-fx-background-color: #2d2d2d; -fx-border-color: #3d3d3d; -fx-border-radius: 3; -fx-cursor: hand"/>
    <Label text="To:" textFill="#a0a0a0"/>
    <DatePicker fx:id="toDate" promptText="No date selected" onAction="#handleDateFilterChange"
                prefHeight="30.0" prefWidth="240.0"
                style="-fx-background-color: #2d2d2d; -fx-border-color: #3d3d3d; -fx-border-radius: 3; -fx-cursor: hand"/>
    <Button mnemonicParsing="false" onAction="#clearDatePickers" prefWidth="240.0"
            style="-fx-background-color: #0d6efd; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;"
            text="Clear">
        <font>
            <Font name="System Bold" size="12.0"/>
        </font>
    </Button>
</VBox>