<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="540.0"
      prefWidth="440.0" style="-fx-background-color: #1e1e1e;" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="fx.tradesjournal.controllers.TradeReadOnlyController">
    <HBox fx:id="titleBar" alignment="CENTER_LEFT" prefHeight="32.0" prefWidth="440.0"
          style="-fx-background-color: #2d2d2d; -fx-border-color: #3d3d3d; -fx-border-width: 0 0 1 0; -fx-cursor: move;">
        <Label text="TradesJournal - Trade Details" textFill="#cccccc">
            <font>
                <Font name="System Bold" size="12.0"/>
            </font>
            <HBox.margin>
                <Insets left="12.0"/>
            </HBox.margin>
        </Label>
        <AnchorPane HBox.hgrow="ALWAYS"/>
        <Button mnemonicParsing="false" onAction="#handleClose"
                style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-cursor: hand;" text="✕">
            <font>
                <Font size="12.0"/>
            </font>
            <HBox.margin>
                <Insets right="8.0"/>
            </HBox.margin>
        </Button>
    </HBox>
    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="12.0"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Trading Journal Entry" textFill="#a0a0a0">
                    <font>
                        <Font size="11.0"/>
                    </font>
                </Label>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="symbolLabel" textFill="#ffffff">
                        <font>
                            <Font name="System Bold" size="18.0"/>
                        </font>
                    </Label>
                    <Label fx:id="typeLabel"
                           style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-padding: 2 6 2 6; -fx-background-radius: 4; -fx-font-weight: bold; -fx-font-size: 11px;"
                           text="BUY / LONG"/>
                </HBox>
            </VBox>
            <HBox alignment="CENTER"
                  style="-fx-background-color: #2d2d2d; -fx-background-radius: 12; -fx-border-color: #3d3d3d; -fx-border-radius: 12;">
                <padding>
                    <Insets bottom="4.0" left="10.0" right="10.0" top="4.0"/>
                </padding>
                <Label fx:id="statusLabel" textFill="#888888">
                    <font>
                        <Font name="System Bold" size="11.0"/>
                    </font>
                </Label>
            </HBox>
        </HBox>
        <Separator prefHeight="1.0" prefWidth="398.0" style="-fx-opacity: 0.2;"/>
        <GridPane hgap="10.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints/>
                <RowConstraints/>
                <RowConstraints/>
                <RowConstraints/>
                <RowConstraints/>
            </rowConstraints>
            <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Entry Date &amp; Time" textFill="#a0a0a0">
                    <font>
                        <Font size="11.0"/>
                    </font>
                </Label>
                <Label fx:id="entryDateTimeLabel" prefHeight="28.0" textFill="WHITE">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Label>
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Entry Price" textFill="#a0a0a0">
                    <font>
                        <Font size="11.0"/>
                    </font>
                </Label>
                <Label fx:id="entryPriceLabel" prefHeight="28.0" textFill="WHITE">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Label>
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Exit Price" textFill="#a0a0a0">
                    <font>
                        <Font size="11.0"/>
                    </font>
                </Label>
                <Label fx:id="exitPriceLabel" prefHeight="28.0" textFill="WHITE">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Label>
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label text="Size / Lots" textFill="#a0a0a0">
                    <font>
                        <Font size="11.0"/>
                    </font>
                </Label>
                <Label fx:id="sizeLabel" prefHeight="28.0" textFill="WHITE">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Label>
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label text="Commissions / Fees" textFill="#a0a0a0">
                    <font>
                        <Font size="11.0"/>
                    </font>
                </Label>
                <Label fx:id="feesLabel" prefHeight="28.0" textFill="WHITE">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Label>
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <Label text="Stop Loss" textFill="#a0a0a0">
                    <font>
                        <Font size="11.0"/>
                    </font>
                </Label>
                <Label fx:id="stopLossLabel" prefHeight="28.0" textFill="#ff6b6b">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Label>
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <Label text="Take Profit" textFill="#a0a0a0">
                    <font>
                        <Font size="11.0"/>
                    </font>
                </Label>
                <Label fx:id="takeProfitLabel" prefHeight="28.0" textFill="#00e676">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Label>
            </VBox>
            <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
                <Label text="Net Profit / Loss" textFill="#a0a0a0">
                    <font>
                        <Font size="11.0"/>
                    </font>
                </Label>
                <HBox alignment="CENTER_LEFT" prefHeight="32.0"
                      style="-fx-background-color: #ffffff; -fx-border-radius: 4; -fx-background-radius: 4;">
                    <padding>
                        <Insets left="10.0" right="10.0"/>
                    </padding>
                    <Label fx:id="profitLossLabel" textFill="#000000">
                        <font>
                            <Font name="System Bold" size="14.0"/>
                        </font>
                    </Label>
                </HBox>
            </VBox>
        </GridPane>
        <VBox spacing="4.0">
            <Label text="Notes / Strategy Setup" textFill="#a0a0a0">
                <font>
                    <Font size="11.0"/>
                </font>
            </Label>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="65.0"
                        style="-fx-background-color: transparent; -fx-background: #2d2d2d; -fx-border-color: #3d3d3d; -fx-border-radius: 3;">
                <Label fx:id="notesLabel" textFill="WHITE" wrapText="true">
                    <padding>
                        <Insets bottom="6.0" left="8.0" right="8.0" top="6.0"/>
                    </padding>
                </Label>
            </ScrollPane>
        </VBox>
        <AnchorPane VBox.vgrow="ALWAYS"/>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Button mnemonicParsing="false" onAction="#handleClose"
                    style="-fx-background-color: #3d3d3d; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 4;"
                    text="Close">
                <font>
                    <Font name="System Bold" size="12.0"/>
                </font>
                <padding>
                    <Insets bottom="6.0" left="20.0" right="20.0" top="6.0"/>
                </padding>
            </Button>
        </HBox>
    </VBox>
</VBox>